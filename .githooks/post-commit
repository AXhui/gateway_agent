#!/usr/bin/env bash
# Git post-commit 钩子：当提交包含 05_release/**/demo.html 时，自动同步到飞书多维表格。
# 与 AI 工具无关——用 Claude Code / Cursor / Windsurf / 任何工具生成 demo，只要 commit 就自动同步。
#
# 安装（仓库根目录执行一次）：
#   git config core.hooksPath .githooks
#
# 已内置团队默认配置（Webhook 地址、Token、NAS 路径），所有同事 clone 下来即可直接使用，无需额外配置。
# 如需覆盖，可通过环境变量设置：
#   FEISHU_WEBHOOK_URL    飞书 Webhook 地址
#   FEISHU_WEBHOOK_TOKEN  飞书 Webhook Token
#   FEISHU_DEMO_BASE_URL  预览地址前缀（HTTP 或 UNC 路径）
#   FEISHU_DEMO_FOLDER_TOKEN  飞书云空间文件夹 token

set -e

# merge/rebase 等场景跳过
if [ -n "$(git rev-parse -q --verify MERGE_HEAD 2>/dev/null)" ]; then
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# 取本次提交中新增/修改的 demo.html
DEMO_FILES=$(git show --name-only --pretty=format: HEAD | grep -E '^05_release/.*/demo\.html$' || true)

if [ -z "$DEMO_FILES" ]; then
  exit 0
fi

COMMIT_MSG=$(git log -1 --pretty=%s)
COMMIT_AUTHOR=$(git log -1 --pretty=%an)
COMMIT_SHA=$(git rev-parse --short HEAD)
# 默认内置团队 NAS 路径，所有同事 clone 下来就能用；如果设置了环境变量则优先用环境变量
DEFAULT_DEMO_BASE_URL='\\192.168.5.50\公共临时文件夹（每季度定期清空）\chenwk\UI_demo'
BASE_URL="${FEISHU_DEMO_BASE_URL:-$DEFAULT_DEMO_BASE_URL}"

echo "[post-commit] 检测到 demo 更新，同步到飞书..."

echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue

  REQ_ID=$(echo "$DEMO_PATH" | sed -n 's|^05_release/\(REQ-[^/]*\)/demo\.html$|\1|p')
  DEMO_NAME="${REQ_ID:+$REQ_ID · }${COMMIT_MSG}"

  # 读取用户本次的原始提示词（AI 按 AGENTS.md 规则写入同目录 prompt.md）；没有则留空
  DEMO_DIR=$(dirname "$DEMO_PATH")
  USER_PROMPT=""
  if [ -f "$DEMO_DIR/prompt.md" ]; then
    USER_PROMPT=$(cat "$DEMO_DIR/prompt.md")
  fi

  # AI 按 AGENTS.md 规则写入的 5 维度自评文件 quality.json；没有则留空（等 UED 打分）
  QUALITY_FILE=""
  if [ -f "$DEMO_DIR/quality.json" ]; then
    QUALITY_FILE="$DEMO_DIR/quality.json"
  fi

  # 生成耗时：commit 时间 - prompt.md 创建时间（分钟，保留1位小数）；prompt.md 不存在则留空
  DURATION=""
  if [ -f "$DEMO_DIR/prompt.md" ]; then
    COMMIT_TS=$(git log -1 --pretty=%ct)
    PROMPT_TS=$(stat -c %Y "$DEMO_DIR/prompt.md" 2>/dev/null || date -r "$DEMO_DIR/prompt.md" +%s 2>/dev/null || echo "")
    if [ -n "$PROMPT_TS" ] && [ -n "$COMMIT_TS" ]; then
      DURATION=$(awk "BEGIN{printf \"%.1f\", ($COMMIT_TS - $PROMPT_TS)/60}")
    fi
  fi

  # 判断该 demo 是首次提交还是再次提交：
  # post-commit 时 HEAD 已包含本次提交，该路径历史提交数 <=1 即首次（新建），否则为更新。
  PREV_COUNT=$(git rev-list --count HEAD -- "$DEMO_PATH" 2>/dev/null || echo 0)
  if [ "$PREV_COUNT" -le 1 ]; then
    ACTION_TYPE="新建"
  else
    ACTION_TYPE="更新"
  fi
  # 版本号：该 demo 第几次提交就是第几版，两位数补零（01、02、03...）
  VERSION_NO=$(printf "%02d" "$PREV_COUNT")

  PREVIEW_URL=""
  if [ -n "$BASE_URL" ]; then
    # 判断是否为 HTTP 地址
    if echo "$BASE_URL" | grep -qE '^https?://'; then
      # HTTP 地址：LATEST=固定最新版，SNAPSHOT=版本快照
      LATEST_URL="${BASE_URL%/}/${DEMO_PATH}"
      SNAPSHOT_URL="${BASE_URL%/}/$(dirname "$DEMO_PATH")/versions/demo_v${VERSION_NO}.html"
      NAS_PATH=$(echo "$BASE_URL" | sed 's|^https\?://|\\\\|; s|/|\\|g')
      LATEST_FILE="${NAS_PATH}\\$(echo "$DEMO_PATH" | tr '/' '\\')"
      REQ_PARENT=$(dirname "$LATEST_FILE")
      SNAPSHOT_FILE="${REQ_PARENT}\\versions\\demo_v${VERSION_NO}.html"
      mkdir -p "$(dirname "$SNAPSHOT_FILE")" 2>/dev/null || true
      cp "$DEMO_PATH" "$LATEST_FILE" 2>/dev/null && \
        echo "[post-commit] 已更新最新版 $LATEST_FILE" || \
        echo "[post-commit] 警告：复制最新版失败（不影响同步）"
      cp "$DEMO_PATH" "$SNAPSHOT_FILE" 2>/dev/null && \
        echo "[post-commit] 已保存版本快照 $SNAPSHOT_FILE" || \
        echo "[post-commit] 警告：保存快照失败（不影响同步）"
      # 预览 URL 统一指向最新版固定地址（LATEST），同一个需求只有一个可访问地址
      PREVIEW_URL="$LATEST_URL"
    elif echo "$BASE_URL" | grep -q '^\\\\'; then
      # UNC 路径：反斜杠拼接。LATEST=固定最新版（覆盖），SNAPSHOT=带版本号快照（不覆盖）
      # macOS 兼容：自动把 \\server\share\dir 转换为 /Volumes/share/dir（需用户先在 Finder 挂载 SMB）
      if [[ "$(uname)" == "Darwin" ]]; then
        # 去掉开头的 \\server\，把反斜杠转正斜杠，前面加 /Volumes/
        NAS_LOCAL=$(echo "$BASE_URL" | sed 's|^\\\\[^\\]*\\||; s|\\|/|g')
        NAS_BASE="/Volumes/${NAS_LOCAL}"
        # 检查是否已挂载
        if [ ! -d "$NAS_BASE" ]; then
          echo "[post-commit] 警告：SMB 共享未挂载到 $NAS_BASE"
          echo "              请在 Finder 按 Cmd+K，输入 smb://192.168.5.50/公共临时文件夹（每季度定期清空） 挂载后重试"
          echo "              （飞书同步仍会执行，只是 NAS 备份跳过）"
          NAS_BASE=""
        fi
      else
        NAS_BASE="$BASE_URL"
      fi

      if [ -n "$NAS_BASE" ]; then
        if [[ "$(uname)" == "Darwin" ]]; then
          # Mac：用正斜杠拼接本地路径
          LATEST_FILE="${NAS_BASE%/}/$(echo "$DEMO_PATH" | tr '\\' '/')"
          REQ_PARENT=$(dirname "$LATEST_FILE")
          SNAPSHOT_FILE="${REQ_PARENT}/versions/demo_v${VERSION_NO}.html"
        else
          # Windows Git Bash：用反斜杠拼接 UNC 路径
          LATEST_FILE="${NAS_BASE%\\}\\$(echo "$DEMO_PATH" | tr '/' '\\')"
          REQ_PARENT=$(dirname "$LATEST_FILE")
          SNAPSHOT_FILE="${REQ_PARENT}\\versions\\demo_v${VERSION_NO}.html"
        fi
        # 1) 覆盖写最新版 demo.html（快捷入口）
        mkdir -p "$REQ_PARENT" 2>/dev/null || true
        cp "$DEMO_PATH" "$LATEST_FILE" 2>/dev/null && \
          echo "[post-commit] 已更新最新版 $LATEST_FILE" || \
          echo "[post-commit] 警告：复制最新版失败（不影响同步）"
        # 2) 另存版本快照（文件名带版本号，永不覆盖）
        mkdir -p "$(dirname "$SNAPSHOT_FILE")" 2>/dev/null || true
        cp "$DEMO_PATH" "$SNAPSHOT_FILE" 2>/dev/null && \
          echo "[post-commit] 已保存版本快照 $SNAPSHOT_FILE" || \
          echo "[post-commit] 警告：保存快照失败（不影响同步）"
      fi
      # 预览 URL 统一指向最新版固定地址（LATEST），同一个需求只有一个可访问地址
      # Mac 下预览 URL 仍用 UNC 格式（飞书表格里显示 UNC 路径，Windows 同事可直接访问）
      PREVIEW_URL="${BASE_URL%\\}\\$(echo "$DEMO_PATH" | tr '/' '\\')"
    else
      PREVIEW_URL="${BASE_URL%/}/${DEMO_PATH}"
    fi
  fi

  # 上传 demo 到飞书云空间，生成可在线预览的链接（优先使用，失败则回退到 NAS 路径）。
  # 注意：Windows 上 lark-cli 的 user token 由 Git Bash/PowerShell 直接调用可读取，
  # 但经 Python subprocess 启动会读不到 Keychain token，因此这里在 Bash 钩子内直接调用 lark-cli。
  FEISHU_FOLDER_TOKEN="${FEISHU_DEMO_FOLDER_TOKEN:-JZeofZysclhJKbd2UCzcAiKDn5d}"
  FEISHU_FILE_NAME="${REQ_ID}_v${VERSION_NO}.html"
  FEISHU_UPLOAD_ERR=$(mktemp 2>/dev/null || echo "")
  FEISHU_UPLOAD_JSON=$(lark-cli drive +upload \
    --file "$DEMO_PATH" \
    --folder-token "$FEISHU_FOLDER_TOKEN" \
    --name "$FEISHU_FILE_NAME" \
    --as user 2>"$FEISHU_UPLOAD_ERR" || true)
  FEISHU_PREVIEW_URL=$(printf '%s' "$FEISHU_UPLOAD_JSON" | python3 -c "import json,sys; data=sys.stdin.read();
try:
 r=json.loads(data); print(r.get('data',{}).get('url','') if r.get('ok') else '')
except Exception:
 print('')" 2>/dev/null || true)
  FEISHU_FILE_TOKEN=$(printf '%s' "$FEISHU_UPLOAD_JSON" | python3 -c "import json,sys; data=sys.stdin.read();
try:
 r=json.loads(data); print(r.get('data',{}).get('file_token','') if r.get('ok') else '')
except Exception:
 print('')" 2>/dev/null || true)
  if [ -n "$FEISHU_PREVIEW_URL" ]; then
    if [ -n "$FEISHU_FILE_TOKEN" ]; then
      FEISHU_PERM_JSON=$(mktemp 2>/dev/null || echo "")
      if [ -n "$FEISHU_PERM_JSON" ]; then
        printf '{"link_share_entity":"tenant_readable"}' > "$FEISHU_PERM_JSON"
        lark-cli drive permission.public patch \
          --token "$FEISHU_FILE_TOKEN" \
          --type file \
          --data "@$FEISHU_PERM_JSON" \
          --yes \
          --as user >/dev/null 2>&1 || echo "[post-commit] 警告：飞书云空间分享权限设置失败（不影响表格同步）"
        rm -f "$FEISHU_PERM_JSON" 2>/dev/null || true
      fi
    fi
    echo "[post-commit] 已上传飞书云空间：$FEISHU_PREVIEW_URL"
    PREVIEW_URL="$FEISHU_PREVIEW_URL"
  else
    if [ -n "$FEISHU_UPLOAD_ERR" ] && [ -s "$FEISHU_UPLOAD_ERR" ]; then
      cat "$FEISHU_UPLOAD_ERR" >&2
    fi
    echo "[post-commit] 警告：飞书云空间上传失败，使用原预览 URL"
  fi
  [ -n "$FEISHU_UPLOAD_ERR" ] && rm -f "$FEISHU_UPLOAD_ERR" 2>/dev/null || true

  # 产品分类自动判断（多层兜底）：quality.json category > prompt关键词 > prd关键词 > commit msg > demo名称
  # AI 漏写 category 时，自动根据 PRD/提示词关键词判断，避免飞书产品分类为空
  PRD_FILE=""
  if [ -f "$DEMO_DIR/prd.md" ]; then
    PRD_FILE="$DEMO_DIR/prd.md"
  fi
  CATEGORY=$(python3 tools/detect_category.py \
    --quality-file "$QUALITY_FILE" \
    --prompt-file "$DEMO_DIR/prompt.md" \
    --prd-file "$PRD_FILE" \
    --commit-msg "$COMMIT_MSG" \
    --demo-name "$DEMO_NAME" 2>/dev/null || true)
  if [ -n "$CATEGORY" ]; then
    echo "[post-commit] 产品分类：$CATEGORY"
  fi

  CATEGORY_ARG=()
  if [ -n "$CATEGORY" ]; then
    CATEGORY_ARG=(--category "$CATEGORY")
  fi

  python3 tools/sync_demo_to_feishu.py \
    --name "$DEMO_NAME" \
    --description "$COMMIT_MSG" \
    --preview-url "$PREVIEW_URL" \
    --generator "$COMMIT_AUTHOR" \
    --version "$VERSION_NO" \
    --source "Agent 生成" \
    --action-type "$ACTION_TYPE" \
    --prompt "$USER_PROMPT" \
    --quality-file "$QUALITY_FILE" \
    --duration "$DURATION" \
    --req-id "$REQ_ID" \
    "${CATEGORY_ARG[@]}" \
    --status "已生成" || echo "[post-commit] 警告：同步失败（不影响提交）"
done

echo "[post-commit] 同步完成"
