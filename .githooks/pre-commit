#!/usr/bin/env bash
# Git pre-commit 钩子：提交 05_release/**/demo.html 时，强制同目录必须一并提交 prompt.md
# （prompt.md 保存用户本次的原始提示词），防止 AI 漏写导致飞书「提示词」为空。
# 如确需跳过：git commit --no-verify

# 暂存区里新增/修改的 demo.html
DEMO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^05_release/.*/demo\.html$' || true)
[ -z "$DEMO_FILES" ] && exit 0

STAGED=$(git diff --cached --name-only)

BAD=""
echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  DIR=$(dirname "$DEMO_PATH")
  if ! echo "$STAGED" | grep -qx "$DIR/prompt.md"; then
    echo "  [缺失] $DIR/prompt.md（用户原始提示词）"
  fi
done

# 汇总判定（上面 while 在子shell，这里重新算一次）
BAD=$(echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  DIR=$(dirname "$DEMO_PATH")
  echo "$STAGED" | grep -qx "$DIR/prompt.md" || echo "$DEMO_PATH"
done)

if [ -n "$BAD" ]; then
  echo ""
  echo "[pre-commit] 提交 demo 前必须先把用户本次的原始提示词写入同目录 prompt.md 并 git add。"
  echo "这是为了让飞书记录留存原始提示词；确认要跳过请用 git commit --no-verify。"
  exit 1
fi

# ===== 组件库校验：demo.html 必须使用组件库，禁止自写样式 =====
BAD_LIB=""
echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  # 从暂存区读取 demo.html 内容，检查组件库标识
  CONTENT=$(git show ":$DEMO_PATH" 2>/dev/null || true)
  # 组件库标识：bc- 前缀业务组件 class、base.css/business.css 引用、MS_CSS 打包变量
  if echo "$CONTENT" | grep -qE 'bc-|base\.css|business\.css|MS_CSS'; then
    : # 使用了组件库，通过
  else
    echo "  [未使用组件库] $DEMO_PATH"
  fi
done

BAD_LIB=$(echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  CONTENT=$(git show ":$DEMO_PATH" 2>/dev/null || true)
  echo "$CONTENT" | grep -qE 'bc-|base\.css|business\.css|MS_CSS' || echo "$DEMO_PATH"
done)

if [ -n "$BAD_LIB" ]; then
  echo ""
  echo "[pre-commit] 检测到 demo 未使用组件库。所有样式必须基于 library/base.css 和 library/business.css 生成，"
  echo "禁止自写一套样式。生成前请先运行 python tools/build-css-bundle.py，并在 demo 中使用 bc-* 组件类。"
  echo "确认要跳过请用 git commit --no-verify。"
  exit 1
fi

# ===== 质量自评校验：quality.json 必须含非空 reason（AI 打分依据文字）=====
BAD_QUALITY=""
echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  DIR=$(dirname "$DEMO_PATH")
  QF="$DIR/quality.json"
  if [ -f "$QF" ]; then
    HAS_REASON=$(python3 -c "import json,sys;
try:
 d=json.load(open('$QF',encoding='utf-8'))
 print('1' if str(d.get('reason','')).strip() else '0')
except Exception:
 print('0')" 2>/dev/null || echo "0")
    if [ "$HAS_REASON" != "1" ]; then
      echo "  [缺失 reason] $QF（AI 自评文字：说明每个维度为什么是这个分数）"
    fi
  else
    echo "  [缺失 quality.json] $DIR/quality.json（5 维度自评文件）"
  fi
done

BAD_QUALITY=$(echo "$DEMO_FILES" | while IFS= read -r DEMO_PATH; do
  [ -z "$DEMO_PATH" ] && continue
  DIR=$(dirname "$DEMO_PATH")
  QF="$DIR/quality.json"
  if [ -f "$QF" ]; then
    HAS_REASON=$(python3 -c "import json,sys;
try:
 d=json.load(open('$QF',encoding='utf-8'))
 print('1' if str(d.get('reason','')).strip() else '0')
except Exception:
 print('0')" 2>/dev/null || echo "0")
    [ "$HAS_REASON" = "1" ] || echo "$QF"
  else
    echo "$QF"
  fi
done)

if [ -n "$BAD_QUALITY" ]; then
  echo ""
  echo "[pre-commit] 提交 demo 前必须完成质量自评：同目录 quality.json 需含 5 维度分数和 reason 自评文字"
  echo "（说明每个维度为什么是这个分数，供 UED 复核；格式见 AGENTS.md）。确认要跳过请用 git commit --no-verify。"
  exit 1
fi

exit 0
