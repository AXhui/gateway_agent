        { "id": "dev-002", "name": "Pudong Cold Chain Hub", "sn": "UG67-240902", "model": "UG67", "status": "online", "firmware": "v2.5.0", "ip": "10.26.4.19", "mac": "64:9B:24:0A:31:02", "lastSeen": "2 分钟前" },
        { "id": "dev-003", "name": "Suzhou Factory Edge", "sn": "UC30-240903", "model": "UC300", "status": "offline", "firmware": "v2.3.8", "ip": "10.26.8.32", "mac": "64:9B:24:0A:31:03", "lastSeen": "18 分钟前" },
        { "id": "dev-004", "name": "Beijing Office Router", "sn": "UR35-240904", "model": "UR35", "status": "error", "firmware": "v1.9.6", "ip": "10.18.0.5", "mac": "64:9B:24:0A:31:04", "lastSeen": "1 小时前" },
        { "id": "dev-005", "name": "Shenzhen R&D Gateway", "sn": "UG65-240905", "model": "UG65", "status": "online", "firmware": "v2.4.3", "ip": "10.7.12.40", "mac": "64:9B:24:0A:31:05", "lastSeen": "刚刚" },
        { "id": "dev-006", "name": "Hangzhou Campus Sensor Hub", "sn": "UC30-240906", "model": "UC300", "status": "offline", "firmware": "v2.3.8", "ip": "10.12.8.14", "mac": "64:9B:24:0A:31:06", "lastSeen": "昨天 19:40" },
        { "id": "dev-007", "name": "Nanjing Logistics Gateway", "sn": "UG67-240907", "model": "UG67", "status": "online", "firmware": "v2.5.0", "ip": "10.25.19.8", "mac": "64:9B:24:0A:31:07", "lastSeen": "5 分钟前" },
