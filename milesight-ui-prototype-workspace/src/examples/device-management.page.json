        { "id": "dev-010", "name": "Xiamen Marine Warehouse", "sn": "UG67-240910", "model": "UG67", "status": "offline", "firmware": "v2.4.1", "ip": "10.16.10.22", "mac": "64:9B:24:0A:31:10", "lastSeen": "昨天 08:12" },
        { "id": "dev-011", "name": "Guangzhou Retail Router", "sn": "UR35-240911", "model": "UR35", "status": "online", "firmware": "v1.9.6", "ip": "10.21.6.10", "mac": "64:9B:24:0A:31:11", "lastSeen": "8 分钟前" },
