        { "id": "dev-017", "name": "Kunming Solar Hub", "sn": "UC30-240917", "model": "UC300", "status": "online", "firmware": "v2.3.8", "ip": "10.52.2.27", "mac": "64:9B:24:0A:31:17", "lastSeen": "刚刚" },
        { "id": "dev-018", "name": "Fuzhou Logistics Gateway", "sn": "UG67-240918", "model": "UG67", "status": "offline", "firmware": "v2.4.1", "ip": "10.34.17.44", "mac": "64:9B:24:0A:31:18", "lastSeen": "昨天 16:28" }
      ]
    }
  ],
  "root": {
    "id": "device-management-root",
    "kind": "component",
    "component": "Layout",
    "props": { "theme": "light" },
    "children": [
      {
        "id": "page-header",
        "kind": "component",
        "component": "PageHeader",
        "props": { "title": "设备管理", "subTitle": "共 18 台设备" },
        "slots": {
          "extra": [
            { "id": "add-device", "kind": "component", "component": "Button", "props": { "type": "primary" }, "content": "添加设备", "events": { "onClick": { "flowId": "notify-add-device" } } },
            { "id": "export-devices", "kind": "component", "component": "Button", "props": { "type": "default" }, "content": "导出", "events": { "onClick": { "flowId": "export-devices" } } }
          ]
        }
      },
      {
        "id": "device-summary-grid",
        "kind": "component",
        "component": "Grid",
        "props": { "gutter": [16, 16], "align": "top" },
        "children": [
          { "id": "summary-total-grid", "kind": "component", "component": "Grid", "props": { "span": 6 }, "children": [{ "id": "summary-total", "kind": "component", "component": "Card", "props": { "bordered": false }, "children": [{ "id": "stat-total", "kind": "component", "component": "Statistic", "props": { "value": { "$lengthOf": { "$data": "devices" } } }, "content": "设备总数" }] }] },
          { "id": "summary-online-grid", "kind": "component", "component": "Grid", "props": { "span": 6 }, "children": [{ "id": "summary-online", "kind": "component", "component": "Card", "props": { "bordered": false }, "children": [{ "id": "stat-online", "kind": "component", "component": "Statistic", "props": { "value": { "$countWhere": { "source": "devices", "field": "status", "equals": "online" } } }, "content": "在线设备" }] }] },
          { "id": "summary-offline-grid", "kind": "component", "component": "Grid", "props": { "span": 6 }, "children": [{ "id": "summary-offline", "kind": "component", "component": "Card", "props": { "bordered": false }, "children": [{ "id": "stat-offline", "kind": "component", "component": "Statistic", "props": { "value": { "$countWhere": { "source": "devices", "field": "status", "equals": "offline" } } }, "content": "离线设备" }] }] },
          { "id": "summary-error-grid", "kind": "component", "component": "Grid", "props": { "span": 6 }, "children": [{ "id": "summary-error", "kind": "component", "component": "Card", "props": { "bordered": false }, "children": [{ "id": "stat-error", "kind": "component", "component": "Statistic", "props": { "value": { "$countWhere": { "source": "devices", "field": "status", "equals": "error" } } }, "content": "故障设备" }] }] }
        ]
      },
      {
        "id": "device-table-card",
        "kind": "component",
        "component": "Card",
        "props": { "bordered": false },
        "children": [
          {
            "id": "filter-toolbar",
            "kind": "component",
            "component": "Space",
            "props": { "size": "middle", "wrap": true },
            "children": [
              { "id": "device-search", "kind": "component", "component": "Input.Search", "props": { "value": { "$state": "filters.search" }, "placeholder": "搜索设备名称、SN 或 MAC", "allowClear": true }, "events": { "onChange": { "flowId": "set-search", "payload": { "value": "$event" } } } },
              { "id": "status-filter", "kind": "component", "component": "Select", "binding": { "source": "state", "path": "filters.status" }, "props": { "options": [{ "label": "全部状态", "value": "all" }, { "label": "在线", "value": "online" }, { "label": "离线", "value": "offline" }, { "label": "故障", "value": "error" }] }, "events": { "onChange": { "flowId": "set-status-filter", "payload": { "value": "$event" } } } },
              { "id": "model-filter", "kind": "component", "component": "Select", "binding": { "source": "state", "path": "filters.model" }, "props": { "options": [{ "label": "全部型号", "value": "all" }, { "label": "UG65", "value": "UG65" }, { "label": "UG67", "value": "UG67" }, { "label": "UC300", "value": "UC300" }, { "label": "UR35", "value": "UR35" }] }, "events": { "onChange": { "flowId": "set-model-filter", "payload": { "value": "$event" } } } },
              { "id": "reset-filters", "kind": "component", "component": "Button", "props": { "type": "default" }, "content": "重置", "events": { "onClick": { "flowId": "reset-filters" } } }
            ]
          },
          {
            "id": "selected-action-bar",
            "kind": "component",
            "component": "Space",
            "props": { "size": "middle" },
            "visibility": { "expr": "state.selectedDeviceIds.length > 0", "fallback": "hide" },
            "children": [
              { "id": "selected-count", "kind": "component", "component": "Typography", "props": { "type": "secondary" }, "content": "已选择设备" },
              { "id": "batch-upgrade", "kind": "component", "component": "Button", "props": { "type": "default" }, "content": "批量升级", "events": { "onClick": { "flowId": "open-batch-upgrade" } } },
              { "id": "export-selected", "kind": "component", "component": "Button", "props": { "type": "link" }, "content": "导出所选", "events": { "onClick": { "flowId": "export-selected" } } },
              { "id": "clear-selection", "kind": "component", "component": "Button", "props": { "type": "link" }, "content": "取消选择", "events": { "onClick": { "flowId": "clear-selection" } } }
            ]
          },
          {
            "id": "device-table",
            "kind": "component",
            "component": "Table",
            "semanticRole": "content-table",
            "props": {
              "dataSource": { "$query": { "source": "devices", "search": { "statePath": "filters.search", "fields": ["name", "sn", "mac"] }, "equals": [{ "statePath": "filters.status", "field": "status", "ignore": "all" }, { "statePath": "filters.model", "field": "model", "ignore": "all" }] } },
              "columns": [{ "key": "name", "title": "设备名称" }, { "key": "sn", "title": "SN" }, { "key": "model", "title": "型号" }, { "key": "status", "title": "状态", "type": "status" }, { "key": "firmware", "title": "Firmware Version" }, { "key": "network", "title": "IP / MAC", "type": "network" }, { "key": "lastSeen", "title": "Last Seen" }, { "key": "actions", "title": "操作", "type": "actions" }],
              "page": { "$state": "currentPage" },
              "pageSize": { "$state": "pageSize" },
              "selectedRowKeys": { "$state": "selectedDeviceIds" },
              "emptyText": "未找到符合条件的设备"
            },
            "events": {
              "onSelectionChange": { "flowId": "select-rows", "payload": { "value": "$event" } },
              "onRowOpen": { "flowId": "open-device-detail", "payload": { "id": "$event.id" } },
              "onRowUpgrade": { "flowId": "open-row-upgrade", "payload": { "id": "$event.id" } },
              "onRowMore": { "flowId": "notify-row-more", "payload": { "name": "$event.name" } }
            }
          },
          { "id": "device-pagination", "kind": "component", "component": "Pagination", "props": { "current": { "$state": "currentPage" }, "total": { "$lengthOf": { "$query": { "source": "devices", "search": { "statePath": "filters.search", "fields": ["name", "sn", "mac"] }, "equals": [{ "statePath": "filters.status", "field": "status", "ignore": "all" }, { "statePath": "filters.model", "field": "model", "ignore": "all" }] } } }, "pageSize": { "$state": "pageSize" }, "showSizeChanger": true }, "events": { "onChange": { "flowId": "change-page", "payload": { "value": "$event" } }, "onPageSizeChange": { "flowId": "change-page-size", "payload": { "value": "$event" } } } }
        ]
      },
      {
        "id": "device-detail-drawer",
        "kind": "component",
        "component": "Drawer",
        "props": { "open": { "$state": "openTargets.deviceDetail" }, "placement": "right", "size": 480 },
        "events": { "onClose": { "flowId": "close-device-detail" } },
        "slots": {
          "header": [{ "id": "detail-title", "kind": "component", "component": "Typography", "props": { "level": 3 }, "content": "设备详情" }],
          "content": [
            { "id": "detail-tabs", "kind": "component", "component": "Tabs", "props": { "type": "line", "activeKey": { "$state": "detailTab" }, "items": [{ "key": "basic", "label": "基本信息" }, { "key": "network", "label": "网络" }, { "key": "firmware", "label": "Firmware" }, { "key": "events", "label": "事件" }] }, "events": { "onChange": { "flowId": "change-detail-tab", "payload": { "value": "$event" } } }, "children": [
              { "id": "detail-basic", "kind": "component", "component": "Descriptions", "props": { "column": 1, "bordered": false, "items": [{ "label": "设备名称", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "name" } } }, { "label": "SN", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "sn" } } }, { "label": "型号", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "model" } } }, { "label": "状态", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "status" } } }] }, "visibility": { "expr": "state.detailTab === 'basic'" } },
              { "id": "detail-network", "kind": "component", "component": "Descriptions", "props": { "column": 1, "bordered": false, "items": [{ "label": "IP", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "ip" } } }, { "label": "MAC", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "mac" } } }, { "label": "Last Seen", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "lastSeen" } } }] }, "visibility": { "expr": "state.detailTab === 'network'" } },
              { "id": "detail-firmware", "kind": "component", "component": "Descriptions", "props": { "column": 1, "bordered": false, "items": [{ "label": "Firmware Version", "value": { "$lookup": { "source": "devices", "id": { "$state": "selectedDeviceId" }, "field": "firmware" } } }, { "label": "升级策略", "value": "自动检查" }] }, "visibility": { "expr": "state.detailTab === 'firmware'" } },
              { "id": "detail-events", "kind": "component", "component": "Descriptions", "props": { "column": 1, "bordered": false, "items": [{ "label": "最近事件", "value": "状态心跳已同步" }, { "label": "告警", "value": "暂无未处理告警" }] }, "visibility": { "expr": "state.detailTab === 'events'" } }
            ] }
          ]
        }
      },
      {
        "id": "firmware-upgrade-drawer",
        "kind": "component",
        "component": "Drawer",
        "props": { "open": { "$state": "openTargets.firmwareUpgrade" }, "placement": "right", "size": 520 },
        "events": { "onClose": { "flowId": "close-firmware-upgrade" } },
        "slots": {
          "header": [{ "id": "upgrade-title", "kind": "component", "component": "Typography", "props": { "level": 3 }, "content": "Firmware Upgrade" }],
          "content": [
            { "id": "upgrade-form", "kind": "component", "component": "Form", "props": { "layout": "vertical" }, "children": [
              { "id": "upgrade-target-label", "kind": "component", "component": "Typography", "props": { "type": "secondary" }, "content": "目标设备" },
              { "id": "upgrade-target", "kind": "component", "component": "Typography", "props": {}, "content": "将对已选设备创建升级任务" },
              { "id": "firmware-version-label", "kind": "component", "component": "Typography", "props": { "type": "secondary" }, "content": "Firmware Version" },
              { "id": "firmware-version", "kind": "component", "component": "Select", "binding": { "source": "state", "path": "upgrade.firmware" }, "props": { "options": [{ "label": "v2.5.0 (Recommended)", "value": "v2.5.0" }, { "label": "v2.4.3", "value": "v2.4.3" }] }, "events": { "onChange": { "flowId": "set-firmware-version", "payload": { "value": "$event" } } } },
              { "id": "firmware-file-label", "kind": "component", "component": "Typography", "props": { "type": "secondary" }, "content": "Firmware File" },
              { "id": "firmware-file", "kind": "component", "component": "Upload", "props": { "accept": ".bin", "multiple": false, "listType": "text", "maxCount": 1 }, "events": { "onChange": { "flowId": "set-firmware-file", "payload": { "value": "$event" } } } },
              { "id": "upgrade-time-label", "kind": "component", "component": "Typography", "props": { "type": "secondary" }, "content": "Upgrade Time" },
              { "id": "upgrade-time-mode", "kind": "component", "component": "Select", "binding": { "source": "state", "path": "upgrade.scheduleMode" }, "props": { "options": [{ "label": "Immediately", "value": "immediately" }, { "label": "Schedule", "value": "schedule" }] }, "events": { "onChange": { "flowId": "set-schedule-mode", "payload": { "value": "$event" } } } },
              { "id": "scheduled-date", "kind": "component", "component": "DatePicker", "props": { "value": { "$state": "upgrade.date" }, "format": "YYYY-MM-DD", "showTime": false, "picker": "date" }, "visibility": { "expr": "state.upgrade.scheduleMode === 'schedule'" }, "events": { "onChange": { "flowId": "set-schedule-date", "payload": { "value": "$event" } } } },
              { "id": "scheduled-time", "kind": "component", "component": "TimePicker", "props": { "value": { "$state": "upgrade.time" }, "format": "HH:mm", "hourStep": 1, "use12Hours": false }, "visibility": { "expr": "state.upgrade.scheduleMode === 'schedule'" }, "events": { "onChange": { "flowId": "set-schedule-time", "payload": { "value": "$event" } } } },
              { "id": "upgrade-progress", "kind": "component", "component": "Progress", "props": { "percent": { "$state": "upgrade.progress" }, "status": { "$state": "upgrade.status" }, "showInfo": true }, "visibility": { "expr": "state.upgrade.running === true" } }
            ] }
          ],
          "footer": [
            { "id": "upgrade-cancel", "kind": "component", "component": "Button", "props": { "type": "default" }, "content": "取消", "events": { "onClick": { "flowId": "close-firmware-upgrade" } } },
            { "id": "upgrade-submit", "kind": "component", "component": "Button", "props": { "type": "primary", "loading": { "$state": "upgrade.running" } }, "content": "开始升级", "events": { "onClick": { "flowId": "start-upgrade" } } }
          ]
        }
      }
    ]
  },
  "flows": [
    { "id": "set-search", "steps": [{ "type": "set-state", "key": "filters.search", "value": "$payload.value" }, { "type": "set-state", "key": "currentPage", "value": 1 }] },
    { "id": "set-status-filter", "steps": [{ "type": "set-state", "key": "filters.status", "value": "$payload.value" }, { "type": "set-state", "key": "currentPage", "value": 1 }] },
    { "id": "set-model-filter", "steps": [{ "type": "set-state", "key": "filters.model", "value": "$payload.value" }, { "type": "set-state", "key": "currentPage", "value": 1 }] },
    { "id": "reset-filters", "steps": [{ "type": "set-state", "key": "filters", "value": { "search": "", "status": "all", "model": "all" } }, { "type": "set-state", "key": "currentPage", "value": 1 }] },
    { "id": "select-rows", "steps": [{ "type": "select", "key": "selectedDeviceIds", "value": "$payload.value" }] },
    { "id": "change-page", "steps": [{ "type": "set-state", "key": "currentPage", "value": "$payload.value" }] },
    { "id": "change-page-size", "steps": [{ "type": "set-state", "key": "pageSize", "value": "$payload.value" }, { "type": "set-state", "key": "currentPage", "value": 1 }] },
    { "id": "clear-selection", "steps": [{ "type": "select", "key": "selectedDeviceIds", "value": [] }] },
    { "id": "open-device-detail", "steps": [{ "type": "set-state", "key": "selectedDeviceId", "value": "$payload.id" }, { "type": "open", "target": "deviceDetail" }] },
    { "id": "close-device-detail", "steps": [{ "type": "close", "target": "deviceDetail" }] },
    { "id": "open-batch-upgrade", "steps": [{ "type": "open", "target": "firmwareUpgrade" }] },
    { "id": "open-row-upgrade", "steps": [{ "type": "select", "key": "selectedDeviceIds", "value": ["$payload.id"] }, { "type": "open", "target": "firmwareUpgrade" }] },
    { "id": "close-firmware-upgrade", "steps": [{ "type": "close", "target": "firmwareUpgrade" }, { "type": "set-state", "key": "upgrade.running", "value": false }] },
    { "id": "set-firmware-version", "steps": [{ "type": "set-state", "key": "upgrade.firmware", "value": "$payload.value" }] },
