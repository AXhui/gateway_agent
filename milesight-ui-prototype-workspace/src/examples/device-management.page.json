{
  "schemaVersion": "1.0.0",
  "meta": {
    "pageId": "device-management",
    "title": "设备管理",
    "pageType": "list",
    "productLine": "iot-platform",
    "businessScenario": "IoT 平台设备管理，运维人员日常使用",
    "userRole": "运维人员",
    "coreFunctions": ["搜索设备", "状态筛选", "查看设备状态", "批量升级", "查看详情", "导出设备清单"],
    "specialRequirements": ["分页", "状态语义", "Loading / Empty / Error / Success 状态", "Design System Token Only"],
    "theme": "light"
  },
  "designSystem": {
    "registry": "component-registry.json",
    "name": "Milesight IOT Web",
    "version": "1.0.0",
    "coverage": { "status": "pending-validation" }
  },
  "state": {
    "filters": { "search": "", "status": "all", "model": "all" },
    "currentPage": 1,
    "pageSize": 6,
    "selectedDeviceIds": [],
    "selectedDeviceId": "",
    "openTargets": { "deviceDetail": false, "firmwareUpgrade": false },
    "detailTab": "basic",
    "upgrade": { "firmware": "v2.5.0", "fileName": "UG-series-v2.5.0.bin", "scheduleMode": "immediately", "date": "2026-09-02", "time": "02:00", "autoResume": true, "running": false, "progress": 0, "status": "normal" },
    "pageStatus": "success"
  },
  "dataSources": [
    {
      "id": "devices",
      "kind": "mock",
