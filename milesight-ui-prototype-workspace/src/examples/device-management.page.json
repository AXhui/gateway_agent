        { "id": "dev-013", "name": "Tianjin Plant Controller", "sn": "UC30-240913", "model": "UC300", "status": "online", "firmware": "v2.3.8", "ip": "10.12.30.71", "mac": "64:9B:24:0A:31:13", "lastSeen": "11 分钟前" },
        { "id": "dev-014", "name": "Ningbo Distribution Gateway", "sn": "UG67-240914", "model": "UG67", "status": "offline", "firmware": "v2.4.1", "ip": "10.44.0.39", "mac": "64:9B:24:0A:31:14", "lastSeen": "2 天前" },
        { "id": "dev-015", "name": "Xi'an Factory Router", "sn": "UR35-240915", "model": "UR35", "status": "online", "firmware": "v1.9.6", "ip": "10.51.3.16", "mac": "64:9B:24:0A:31:15", "lastSeen": "15 分钟前" },
